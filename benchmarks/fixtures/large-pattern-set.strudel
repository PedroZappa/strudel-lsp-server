function voice(index, pattern) {
  return s(pattern).gain(0.4 + index / 100).slow(index)
}

function accent(pattern, weight) {
  return pattern.fast(weight).degradeBy(0.15)
}

const v0 = voice(1, "bd [sd sd]")
const v1 = voice(2, "[hh]*4")
const v2 = voice(3, "sd ~ sd [sd sd]")
const v3 = voice(4, "bd*2 [hh hh]")
const v4 = voice(5, "[c2 e2 g2]")
const v5 = voice(6, "sd [~ sd] sd*2")
const v6 = voice(7, "[hh hh hh hh]*2")
const v7 = voice(8, "bd ~ [bd bd] ~")
const v8 = voice(9, "[a3 c4 e4]")
const v9 = voice(10, "sd*4 [sd sd sd]")
const v10 = accent(v0, 2)
const v11 = accent(v1, 3)
const v12 = accent(v2, 2)
const v13 = accent(v3, 4)
const v14 = accent(v4, 2)
const v15 = accent(v5, 3)
const v16 = accent(v6, 2)
const v17 = accent(v7, 4)
const v18 = accent(v8, 2)
const v19 = accent(v9, 3)
const v20 = v10.add(v11).degradeBy(0.1)
const v21 = v12.add(v13).gain(0.6)
const v22 = v14.add(v15).slow(2)
const v23 = v16.add(v17).fast(2)
const v24 = v18.add(v19).gain(0.5)
const v25 = v20.stack(v21)
const v26 = v22.stack(v23)
const v27 = v24.stack(v25)
const v28 = v26.stack(v27)
const v29 = v28.fast(2).degradeBy(0.2)
const v30 = v29.add(v20).slow(1.5)
const v31 = v30.gain(0.9).fast(1.25)
const v32 = v31.stack(v21).degradeBy(0.05)
const v33 = v32.slow(4)
const v34 = v33.add(v25).gain(0.7)
const v35 = v34.fast(3)
const v36 = v35.stack(v27).degradeBy(0.25)
const v37 = v36.slow(2).gain(0.8)
const v38 = v37.add(v29)
const v39 = v38.fast(1.5).degradeBy(0.1)
const v40 = v39.stack(v31).slow(1.25)
const v41 = v40.gain(0.65).fast(2)
const v42 = v41.add(v33).degradeBy(0.3)
const v43 = v42.stack(v35).slow(3)
const v44 = v43.gain(0.75)
v44.fast(2).degradeBy(0.05)
