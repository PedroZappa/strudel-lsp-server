{
  "name": "strudel-lsp",
  "displayName": "strudel-lsp-server",
  "description": "A language server for Strudel",
  "author": "Zedro",
  "license": "MIT",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroZappa/strudel-lsp-server"
  },
  "publisher": "Zedro",
  "categories": [
    "LSP"
  ],
  "keywords": [
    "strudel",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "activationEvents": [
    "onLanguage:strudel"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Default Configuration",
      "properties": {}
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "sh ./scripts/e2e.sh"
  },
  "dependencies": {
    "tree-sitter": "0.25.1",
    "tree-sitter-strudel": "1.1.8",
    "vscode-languageserver": "11.0.1",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/reference": "1.2.2",
    "@strudel/transpiler": "1.2.6",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/node": "26.6.10",
    "eslint": "9.33.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
