{
  "name": "strudel-lsp-server",
  "description": "Editor-agnostic Language Server Protocol implementation for Strudel",
  "author": "Zedro",
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroZappa/strudel-lsp-server"
  },
  "keywords": [
    "strudel",
    "lsp",
    "language-server"
  ],
  "bin": {
    "strudel-lsp-server": "./dist/src/server.js"
  },
  "files": [
    "dist/src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:parser": "npm run build && node --test \"dist/test/parser/**/*.test.js\"",
    "test:semantic": "npm run build && node --test \"dist/test/semantic/**/*.test.js\"",
    "test:metadata": "npm run build && node --test \"dist/test/metadata/**/*.test.js\"",
    "test:features": "npm run build && node --test \"dist/test/features/**/*.test.js\"",
    "test:mini": "npm run build && node --test \"dist/test/miniNotation/**/*.test.js\"",
    "generate:metadata": "node scripts/generate-metadata.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "tree-sitter": "0.25.1",
    "tree-sitter-strudel": "2.0.2",
    "vscode-languageserver": "11.0.1",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/reference": "1.2.2",
    "@strudel/transpiler": "1.2.6",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/node": "26.6.10",
    "eslint": "9.33.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
